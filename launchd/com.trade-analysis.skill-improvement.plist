<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Install all maintenance agents from the repository root:
     python3 scripts/install_launchd.py
     Add the load option to activate schedules.
     Existing customized plists are preserved; see docs/dev/maintenance-runbook.md. -->
<dict>
	<key>Label</key>
	<string>com.trade-analysis.skill-improvement</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>$PROJECT_DIR/scripts/run_skill_improvement.sh</string>
	</array>

	<key>WorkingDirectory</key>
	<string>$PROJECT_DIR</string>

	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>5</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/opt/homebrew/sbin:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>HOME</key>
		<string>$HOME</string>
	</dict>

	<key>StandardOutPath</key>
	<string>$PROJECT_DIR/logs/launchd_skill_improvement.log</string>

	<key>StandardErrorPath</key>
	<string>$PROJECT_DIR/logs/launchd_skill_improvement_error.log</string>

	<key>RunAtLoad</key>
	<false/>
</dict>
</plist>
