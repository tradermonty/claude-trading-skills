# Copy to .env (cp .env.example .env), then fill in. Never commit .env.
# chmod 600 .env so only you can read it.

# ---- Alpaca (read-only use: the dashboard only reads account + positions)
# paper = simulated money (paper-api.alpaca.markets)
# live  = your real account (api.alpaca.markets). Use your LIVE key pair with it.
ALPACA_ENV=paper
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ---- Optional: nightly VCP screen in the refresh job (uses FMP API calls)
RUN_VCP=false
FMP_API_KEY=

# ---- Times on the page
TZ_DISPLAY=America/New_York
