# Copy to .env (cp .env.example .env), then fill in. Never commit .env.
# chmod 600 .env so only you can read it.

# ---- Alpaca (read-only use: the dashboard only reads account + positions)
# paper = simulated money (paper-api.alpaca.markets)
# live  = your real account (api.alpaca.markets). Use your LIVE key pair with it.
ALPACA_ENV=paper
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ---- Optional: nightly VCP screen in the refresh job (uses FMP API calls)
RUN_VCP=false
FMP_API_KEY=

# ---- Optional: drawdown circuit breaker (reads state/theses, no API key)
# Your trading account size in dollars. Leave empty to skip the check.
CB_ACCOUNT_SIZE=
# Optional overrides; defaults are 2% daily, 2 losses -> 24h cooldown, 5% weekly, 8% monthly
CB_MAX_DAILY_LOSS_PCT=
CB_LOSING_STREAK_N=
CB_COOLDOWN_HOURS=
CB_WEEKLY_DRAWDOWN_PCT=
CB_MONTHLY_DRAWDOWN_PCT=

# ---- Times on the page
TZ_DISPLAY=America/New_York
