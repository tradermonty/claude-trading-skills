"""Alpaca market data: the default source for US daily bars and price quotes.

Alpaca carries US equity / ETF OHLCV only. Callers use it first for symbols it
covers and fall back to FMP (or yfinance) for everything else: non-US symbols,
indices, fundamentals, profiles, calendars, and any symbol Alpaca returns no
bars for. Every failure here is swallowed and reported as "no data", so the
fallback path always runs.

Enabled when ALPACA_API_KEY and ALPACA_SECRET_KEY are set. Set
MARKET_DATA_SOURCE=fmp to force the old FMP-only behavior. ALPACA_DATA_FEED
picks the feed (default ``sip``; on a 403, e.g. a free plan asking for bars
newer than 15 minutes, the request is retried once on ``iex``).
"""

from __future__ import annotations

import math
import os
import re
import sys
from datetime import date, datetime, timedelta, timezone
from typing import Any, Callable

try:
    import requests
except ImportError:  # pragma: no cover - requests is a declared dependency
    requests = None

BARS_URL = "https://data.alpaca.markets/v2/stocks/bars"
_SYMBOLS_PER_REQUEST = 100
_QUOTE_DAYS = 252
_MIN_FETCH_DAYS = 300
# US tickers: 1-5 capitals, optionally a one-letter share class (BRK-B / BRK.B).
_US_SYMBOL_RE = re.compile(r"^[A-Z]{1,5}(?:[.-][A-Z])?$")


def is_us_equity_symbol(symbol: str) -> bool:
    """True for symbols Alpaca can serve (US equities and ETFs)."""
    return bool(symbol) and bool(_US_SYMBOL_RE.match(symbol))


def _alpaca_symbol(symbol: str) -> str:
    return symbol.replace("-", ".")


def _to_row(bar: dict) -> dict:
    close = bar["c"]
    return {
        "date": str(bar["t"])[:10],
        "open": bar["o"],
        "high": bar["h"],
        "low": bar["l"],
        "close": close,
        "adjClose": close,
        "volume": bar["v"],
    }


class AlpacaDailyBars:
    """Daily OHLCV from Alpaca, returned in FMP's most-recent-first row shape."""

    def __init__(self, key_id: str, secret: str, feed: str = "sip", timeout: int = 30):
        self._headers = {"APCA-API-KEY-ID": key_id, "APCA-API-SECRET-KEY": secret}
        self.feed = feed
        self.timeout = timeout
        self.calls_made = 0
        # symbol -> (rows oldest-first, number of trading days requested)
        self._cache: dict[str, tuple[list[dict], int]] = {}
        self._http_get: Callable[[str, dict], Any] = self._default_get

    @classmethod
    def from_env(cls) -> AlpacaDailyBars | None:
        if os.getenv("MARKET_DATA_SOURCE", "").strip().lower() == "fmp":
            return None
        key_id = (os.getenv("ALPACA_API_KEY") or "").strip()
        secret = (os.getenv("ALPACA_SECRET_KEY") or "").strip()
        if not key_id or not secret or requests is None:
            return None
        feed = (os.getenv("ALPACA_DATA_FEED") or "sip").strip().lower()
        return cls(key_id, secret, feed=feed)

    def _default_get(self, url: str, params: dict):
        return requests.get(url, headers=self._headers, params=params, timeout=self.timeout)

    def _request(self, params: dict) -> dict[str, list[dict]]:
        """All pages for one request. Raises on HTTP errors other than the iex retry."""
        out: dict[str, list[dict]] = {}
        params = dict(params)
        feed = self.feed
        while True:
            params["feed"] = feed
            self.calls_made += 1
            resp = self._http_get(BARS_URL, params)
            if resp.status_code == 403 and feed != "iex":
                feed = self.feed = "iex"  # remember for the rest of the run
                params.pop("page_token", None)
                out = {}
                continue
            if resp.status_code != 200:
                raise RuntimeError(f"Alpaca bars HTTP {resp.status_code}: {resp.text[:200]}")
            payload = resp.json() or {}
            for sym, bars in (payload.get("bars") or {}).items():
                out.setdefault(sym, []).extend(bars or [])
            token = payload.get("next_page_token")
            if not token:
                return out
            params["page_token"] = token

    def _fetch(self, symbols: list[str], start: str, end: str | None) -> dict[str, list[dict]]:
        """Fetch bars for eligible symbols; returns {requested_symbol: rows oldest-first}."""
        wanted = {}
        for sym in symbols:
            if is_us_equity_symbol(sym):
                wanted.setdefault(_alpaca_symbol(sym), []).append(sym)
        result: dict[str, list[dict]] = {}
        names = list(wanted)
        for i in range(0, len(names), _SYMBOLS_PER_REQUEST):
            chunk = names[i : i + _SYMBOLS_PER_REQUEST]
            params = {
                "symbols": ",".join(chunk),
                "timeframe": "1Day",
                "start": start,
                "adjustment": "split",
                "limit": 10000,
            }
            if end:
                params["end"] = end
            try:
                data = self._request(params)
            except Exception as exc:  # network, auth, plan: fall back to FMP
                print(f"WARN: Alpaca bars unavailable ({exc}); using FMP", file=sys.stderr)
                continue
            for alp_sym, bars in data.items():
                rows = [_to_row(b) for b in sorted(bars, key=lambda b: b["t"])]
                if not rows:
                    continue
                for requested in wanted.get(alp_sym, []):
                    result[requested] = rows
        return result

    def daily_bars(self, symbols: list[str], days: int) -> dict[str, list[dict]]:
        """Last ``days`` trading days per symbol, most-recent-first. Missing = not covered."""
        need = [
            s
            for s in dict.fromkeys(symbols)
            if is_us_equity_symbol(s) and (s not in self._cache or self._cache[s][1] < days)
        ]
        if need:
            # Fetch a floor of _MIN_FETCH_DAYS so quote and screener windows
            # share one request. ~252 trading days per 365 calendar days.
            fetch_days = max(days, _MIN_FETCH_DAYS)
            span = int(math.ceil(fetch_days * 365 / 252)) + 10
            start = (datetime.now(timezone.utc) - timedelta(days=span)).strftime("%Y-%m-%d")
            fetched = self._fetch(need, start, None)
            for sym in need:
                if sym in fetched:
                    self._cache[sym] = (fetched[sym], fetch_days)
        out = {}
        for sym in symbols:
            if sym in self._cache:
                out[sym] = list(reversed(self._cache[sym][0]))[:days]
        return out

    def daily_bars_between(self, symbol: str, from_date: str, to_date: str) -> list[dict] | None:
        """Bars between two ISO dates (inclusive), oldest-first. None = not covered."""
        if not is_us_equity_symbol(symbol):
            return None
        end = (date.fromisoformat(to_date[:10]) + timedelta(days=1)).isoformat()
        rows = self._fetch([symbol], from_date[:10], end).get(symbol)
        if not rows:
            return None
        return [r for r in rows if from_date[:10] <= r["date"] <= to_date[:10]]

    def quotes(self, symbols: list[str]) -> dict[str, dict]:
        """FMP-style quote dicts derived from daily bars (price fields only).

        Fundamentals (marketCap, pe, eps, name, ...) are deliberately absent:
        Alpaca does not carry them, and consumers fall back to their defaults.
        """
        bars = self.daily_bars(symbols, _QUOTE_DAYS)
        out = {}
        for sym, rows in bars.items():
            if not rows:
                continue
            last = rows[0]
            prev = rows[1]["close"] if len(rows) > 1 else None
            window = rows[:_QUOTE_DAYS]
            vol_window = rows[:50]
            quote = {
                "symbol": sym,
                "price": last["close"],
                "open": last["open"],
                "dayHigh": last["high"],
                "dayLow": last["low"],
                "previousClose": prev,
                "change": (last["close"] - prev) if prev else None,
                "changesPercentage": ((last["close"] - prev) / prev * 100) if prev else None,
                "volume": last["volume"],
                "avgVolume": sum(r["volume"] for r in vol_window) / len(vol_window),
                "yearHigh": max(r["high"] for r in window),
                "yearLow": min(r["low"] for r in window),
                "priceAvg50": sum(r["close"] for r in rows[:50]) / len(rows[:50]),
                "priceAvg200": sum(r["close"] for r in rows[:200]) / len(rows[:200]),
                "date": last["date"],
                "dataSource": "alpaca",
            }
            out[sym] = quote
        return out
