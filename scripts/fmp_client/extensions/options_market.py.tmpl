    def fetch_options_history(self, symbol: str):
        """Raw stable full EOD evidence; caller owns dates, basis and selection."""
        return self._rate_limited_get(
            "https://financialmodelingprep.com/stable/historical-price-eod/full",
            {"symbol": symbol},
            quiet=True,
        )

