    def fetch_news_eod(self, symbol: str, from_date: str, to_date: str):
        """Raw stable light rows; caller owns schema and information cutoff."""
        return self._rate_limited_get(
            "https://financialmodelingprep.com/stable/historical-price-eod/light",
            {"symbol": symbol, "from": from_date, "to": to_date},
            quiet=True,
        )
