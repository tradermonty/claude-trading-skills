{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Limited holdings allocation report version 1",
  "description": "Shared output for local CSV and saved Alpaca positions. Decimal values are strings; runtime validation enforces numeric limits and arithmetic.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "provenance",
    "currency",
    "gross_holdings_value",
    "net_holdings_value",
    "positions",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report_type": {
      "const": "holdings_allocation_only"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "as_of",
        "freshness"
      ],
      "properties": {
        "source": {
          "enum": [
            "local_csv",
            "alpaca_positions_snapshot"
          ]
        },
        "as_of": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|\\+00:00)$"
        },
        "freshness": {
          "const": "operator_asserted"
        }
      }
    },
    "currency": {
      "const": "USD"
    },
    "gross_holdings_value": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "net_holdings_value": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "positions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "asset_type",
          "direction",
          "quantity",
          "price",
          "currency",
          "cost_basis",
          "gross_market_value",
          "net_market_value",
          "gross_weight_pct",
          "unrealized_pnl"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9.-]{0,23}$"
          },
          "asset_type": {
            "const": "equity"
          },
          "direction": {
            "enum": [
              "LONG",
              "SHORT"
            ]
          },
          "quantity": {
            "type": "string",
            "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
          },
          "price": {
            "type": "string",
            "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
          },
          "currency": {
            "const": "USD"
          },
          "cost_basis": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "gross_market_value": {
            "type": "string",
            "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
          },
          "net_market_value": {
            "type": "string",
            "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
          },
          "gross_weight_pct": {
            "type": "string",
            "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
          },
          "unrealized_pnl": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
